# aa_drt: DRT at 1 sample per pixel through the pixel centre. Besides geometric and
# texture aliasing, the pinhole camera + single centred sample also aliases the
# shading (each pixel takes one point of the soft shadow).
Scale -1 1 1
LookAt 0 2.0 6.5   0 1.3 -3   0 1 0
Camera "perspective" "float fov" [50]
Film "rgb" "integer xresolution" [480] "integer yresolution" [320] "string filename" "aa_drt.png"
     "string tonemap" "reinhard" "float key" [0.18]
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
Integrator "distributed" "integer maxdepth" [1] "integer branching" [4] "integer lightsamples" [16] "string lightsampler" "halton"
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [14 13.5 12]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-4 7 4   -2 7 4   -4 7 6   -2 7 6] "integer indices" [0 1 2 3]
AttributeEnd
LightSource "distant" "point3 from" [3 5 2] "point3 to" [0 0 0] "rgb L" [0.45 0.45 0.5]
LightSource "infinite" "rgb L" [0.25 0.3 0.4]
Include "include/aa_geometry.pbrt"
