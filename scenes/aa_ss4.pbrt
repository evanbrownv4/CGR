# aa_ss4: WSRT supersampling with 4 sample(s) per pixel on a regular 2x2 grid
# inside each pixel, averaged with a box filter. Compare quality vs render time (in the .log).
Scale -1 1 1
LookAt 0 2.0 6.5   0 1.3 -3   0 1 0
Camera "perspective" "float fov" [50]
Film "rgb" "integer xresolution" [480] "integer yresolution" [320] "string filename" "aa_ss4.png"
Sampler "stratified" "integer xsamples" [2] "integer ysamples" [2] "bool jitter" false
Integrator "whitted" "integer maxdepth" [3] "rgb ambient" [0.12 0.12 0.12]
WorldBegin
LightSource "point" "point3 from" [-3 6 6] "rgb I" [60 58 52]
LightSource "distant" "point3 from" [3 5 2] "point3 to" [0 0 0] "rgb L" [0.45 0.45 0.5]
LightSource "infinite" "rgb L" [0.55 0.65 0.85]
Include "include/aa_geometry.pbrt"
