# aa_wsrt: WSRT at 1 sample per pixel through the pixel centre (no antialiasing).
# Thin fence posts break up / disappear, the fine floor checkerboard produces Moire
# patterns towards the horizon and the starburst spokes show stair-stepped edges.
Scale -1 1 1
LookAt 0 2.0 6.5   0 1.3 -3   0 1 0
Camera "perspective" "float fov" [50]
Film "rgb" "integer xresolution" [480] "integer yresolution" [320] "string filename" "aa_wsrt.png"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
Integrator "whitted" "integer maxdepth" [3] "rgb ambient" [0.12 0.12 0.12]
WorldBegin
LightSource "point" "point3 from" [-3 6 6] "rgb I" [60 58 52]
LightSource "distant" "point3 from" [3 5 2] "point3 to" [0 0 0] "rgb L" [0.45 0.45 0.5]
LightSource "infinite" "rgb L" [0.55 0.65 0.85]
Include "include/aa_geometry.pbrt"
