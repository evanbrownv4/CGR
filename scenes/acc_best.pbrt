# acc_best: best case for the BVH. 4096 small spheres on a 64 x 64 grid (spacing 0.5)
# above a floor plane: primitives are small, uniformly distributed and do not overlap,
# so each BVH node splits space cleanly and a ray only visits the few leaves along its
# path. Without the BVH every camera and shadow ray tests all 4096 spheres.
Scale -1 1 1
LookAt 0 9 17   0 0 -2   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [480] "integer yresolution" [360] "string filename" "acc_best.png"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
Integrator "whitted" "integer maxdepth" [2] "rgb ambient" [0.1 0.1 0.1]
WorldBegin
LightSource "point" "point3 from" [6 14 10] "rgb I" [500 480 450]
LightSource "infinite" "rgb L" [0.5 0.6 0.8]
Material "diffuse" "rgb reflectance" [0.6 0.6 0.6]
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]

AttributeBegin Translate -15.750 0.305 -15.750 Material "phong" "rgb Kd" [0.8 0.2 0.15] "rgb Ks" [0.3 0.3 0.3] "float exponent" [40] Shape "sphere" "float radius" [0.18] AttributeEnd
AttributeBegin Translate -15.750 0.305 -15.250 Material "phong" "rgb Kd" [0.8 0.2 0.15] "rgb Ks" [0.3 0.3 0.3] "float exponent" [40] Shape "sphere" "float radius" [0.18] AttributeEnd
