# acc_complex: a sculpture gallery with ~350 objects (~280k triangles): 120 plinths, each
# carrying a sphere, a low-poly sphere, a mug, a vase or a torus, under two area lights
# and three point lights, rendered with the DRT. Brute-force intersection would
# test every primitive for every camera, shadow and indirect ray.
Scale -1 1 1
LookAt 0 4 8.5   0 0.6 -5   0 1 0
Camera "perspective" "float fov" [55]
Film "rgb" "integer xresolution" [640] "integer yresolution" [400] "string filename" "acc_complex.png"
     "string tonemap" "reinhard" "float key" [0.2]
Sampler "stratified" "integer xsamples" [2] "integer ysamples" [2]
Integrator "distributed" "integer maxdepth" [1] "integer branching" [2]
           "integer lightsamples" [4] "string lightsampler" "halton"
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [6 6 6.5]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-9 8 -10  -3 8 -10  -9 8 -4  -3 8 -4] "integer indices" [0 1 2 3]
  Shape "bilinearmesh" "point3 P" [3 8 -4  9 8 -4  3 8 2  9 8 2] "integer indices" [0 1 2 3]
AttributeEnd
LightSource "point" "point3 from" [-8 4 6] "rgb I" [40 34 28]
LightSource "point" "point3 from" [8 4 6] "rgb I" [28 34 40]
LightSource "point" "point3 from" [0 6 -14] "rgb I" [60 60 60]
LightSource "infinite" "rgb L" [0.04 0.04 0.05]
Texture "chk" "spectrum" "checkerboard" "float uscale" [0.5] "float vscale" [0.5] "rgb tex1" [0.7 0.68 0.65] "rgb tex2" [0.35 0.33 0.3]
Material "diffuse" "texture reflectance" "chk"
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
Material "diffuse" "rgb reflectance" [0.6 0.6 0.62]
Shape "plane" "point3 p" [0 0 -16] "normal n" [0 0 1]

AttributeBegin Translate -8.80 0.25 2.00 Scale 0.7 0.5 0.7 Material "diffuse" "rgb reflectance" [0.75 0.75 0.72] Shape "objmesh" "string filename" "assets/cube.obj" AttributeEnd
AttributeBegin Translate -8.80 0.85 2.00 Material "phong" "rgb Kd" [0.64 0.16 0.12] "rgb Ks" [0.2 0.2 0.2] "float exponent" [60] Shape "sphere" "float radius" [0.35] AttributeEnd
