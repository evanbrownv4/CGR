# Sphere with a high-frequency stripe texture
AttributeBegin
  Translate 1.6 0.9 0.5
  Rotate -90 1 0 0
  Texture "stripes" "spectrum" "checkerboard" "float uscale" [40] "float vscale" [1] "rgb tex1" [0.95 0.85 0.2] "rgb tex2" [0.1 0.1 0.4]
  Material "phong" "texture Kd" "stripes" "rgb Ks" [0.3 0.3 0.3] "float exponent" [50]
  Shape "sphere" "float radius" [0.9]
AttributeEnd
