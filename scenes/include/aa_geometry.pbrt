# Backing panel behind the starburst
AttributeBegin
  Translate 0 0 -1.05
  Material "diffuse" "rgb reflectance" [0.85 0.85 0.8]
  Shape "bilinearmesh" "point3 P" [-4.3 0.4 0  -0.7 0.4 0  -4.3 4.0 0  -0.7 4.0 0] "integer indices" [0 1 2 3]
