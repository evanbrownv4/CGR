# Shared geometry for aa_*: features that alias at 1 sample per pixel:
#  - a picket fence of thin posts (jagged / missing posts)
#  - a fine checkerboard floor receding to the horizon (Moire patterns)
#  - a starburst of thin triangles (stair-stepped edges, broken spokes)
#  - a brick texture viewed at a grazing angle and a striped sphere
Texture "fine" "spectrum" "checkerboard" "float uscale" [2] "float vscale" [2] "rgb tex1" [0.9 0.9 0.9] "rgb tex2" [0.05 0.05 0.05]
Material "diffuse" "texture reflectance" "fine"
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
AttributeBegin
  Translate 0 0 -2
  Material "phong" "rgb Kd" [0.8 0.75 0.6] "rgb Ks" [0.2 0.2 0.2] "float exponent" [30]
  Shape "objmesh" "string filename" "assets/fence.obj"
AttributeEnd
# Brick wall at a grazing angle
AttributeBegin
  Translate 5 0 -6
  Rotate -70 0 1 0
  Texture "brick" "spectrum" "imagemap" "string filename" "assets/brick.ppm" "float uscale" [1] "float vscale" [1]
  Material "diffuse" "texture reflectance" "brick"
  Shape "bilinearmesh" "point3 P" [0 0 0  12 0 0  0 4 0  12 4 0] "integer indices" [0 1 2 3] "point2 uv" [0 0 4 0 0 1.333 4 1.333]
AttributeEnd
