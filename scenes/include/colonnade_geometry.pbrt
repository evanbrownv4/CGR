# Shared geometry for camera_persp*: a long colonnade (two rows of 12 columns,
# 3 units apart) on a checker floor receding from the viewer. Perspective
# foreshortening (distant columns appear smaller, parallel rows converge to a
# vanishing point) is what conveys the depth of this scene.
Texture "chk" "spectrum" "checkerboard" "float uscale" [0.5] "float vscale" [0.5] "rgb tex1" [0.8 0.78 0.72] "rgb tex2" [0.3 0.28 0.25]
Material "diffuse" "texture reflectance" "chk"
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
Material "phong" "rgb Kd" [0.85 0.82 0.75] "rgb Ks" [0.15 0.15 0.15] "float exponent" [30]
AttributeBegin
  Translate -2.5 1.5 0
  Scale 0.5 3 0.5
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate -2.5 3.2 0
  Shape "sphere" "float radius" [0.35]
AttributeEnd
