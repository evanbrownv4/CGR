# Shared geometry for WSRT_creative / DRT_creative: a study desk inspired by a
# photograph of a real desk (mug, stack of books with a globe, glass paperweight,
# vase, metal sculpture and a small mirror against a plastered wall).
# Paths are relative to the scenes/ directory (the including file).

# Desk top (wood) and wall (plaster)
Texture "deskwood" "spectrum" "imagemap" "string filename" "assets/wood.ppm" "float uscale" [0.5] "float vscale" [0.5]
Material "phong" "texture Kd" "deskwood" "rgb Ks" [0.15 0.15 0.15] "float exponent" [40]
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
Material "diffuse" "rgb reflectance" [0.75 0.72 0.65]
Shape "plane" "point3 p" [0 0 -3] "normal n" [0 0 1]

# Coffee mug (glazed ceramic), handle pointing towards the camera-left
AttributeBegin
  Translate -0.9 0 0.2
  Rotate 200 0 1 0
  Scale 0.55 0.55 0.55
  Material "phong" "rgb Kd" [0.6 0.64 0.7] "rgb Ks" [0.3 0.3 0.3] "float exponent" [90]
  Shape "objmesh" "string filename" "assets/mug.obj" "bool smooth" true
AttributeEnd

# Stack of three books
AttributeBegin
  Translate 1.35 0.1 -0.4
  Rotate 8 0 1 0
  Scale 1.3 0.2 0.95
  Material "phong" "rgb Kd" [0.55 0.08 0.06] "rgb Ks" [0.1 0.1 0.1] "float exponent" [20]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate 1.3 0.3 -0.42
  Rotate -5 0 1 0
  Scale 1.2 0.2 0.9
  Material "phong" "rgb Kd" [0.08 0.2 0.45] "rgb Ks" [0.1 0.1 0.1] "float exponent" [20]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate 1.33 0.47 -0.38
  Rotate 15 0 1 0
  Scale 1.0 0.14 0.75
  Material "phong" "rgb Kd" [0.1 0.4 0.15] "rgb Ks" [0.1 0.1 0.1] "float exponent" [20]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd

# Globe resting on the books
AttributeBegin
  Translate 1.3 0.98 -0.4
  Rotate -100 1 0 0
  Texture "planet" "spectrum" "imagemap" "string filename" "assets/planet.ppm"
  Material "phong" "texture Kd" "planet" "rgb Ks" [0.3 0.3 0.3] "float exponent" [80]
  Shape "sphere" "float radius" [0.44]
AttributeEnd

# Glass paperweight
AttributeBegin
  Translate 0.25 0.32 0.95
  Material "dielectric" "float eta" [1.5]
  Shape "sphere" "float radius" [0.32]
AttributeEnd

# Marble vase
AttributeBegin
  Translate -2.1 0 -1.4
  Scale 0.55 0.55 0.55
  Texture "marble" "spectrum" "imagemap" "string filename" "assets/marble.ppm" "float uscale" [2]
  Material "phong" "texture Kd" "marble" "rgb Ks" [0.25 0.25 0.25] "float exponent" [120]
  Shape "objmesh" "string filename" "assets/vase.obj" "bool smooth" true
AttributeEnd

# Metal knot sculpture on a small marble plinth
AttributeBegin
  Translate 0.0 0.08 -1.6
  Scale 0.5 0.16 0.5
  Material "diffuse" "rgb reflectance" [0.2 0.2 0.22]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate 0.0 0.62 -1.6
  Rotate 90 1 0 0
  Scale 0.55 0.55 0.55
  Material "phong" "rgb Kd" [0.08 0.06 0.03] "rgb Ks" [0.7 0.55 0.3] "float exponent" [150]
  Shape "objmesh" "string filename" "assets/knot.obj" "bool smooth" true
AttributeEnd

# Small mirror leaning against the wall
AttributeBegin
  Translate 2.6 0 -2.6
  Rotate -35 0 1 0
  Material "mirror" "rgb Kr" [0.85 0.85 0.85]
  Shape "bilinearmesh" "point3 P" [-0.6 0.05 0   0.6 0.05 0   -0.6 1.7 -0.25   0.6 1.7 -0.25]
        "integer indices" [0 1 2 3]
  Material "diffuse" "rgb reflectance" [0.1 0.07 0.05]
  Shape "bilinearmesh" "point3 P" [-0.65 0 -0.01   0.65 0 -0.01   -0.65 1.75 -0.27   0.65 1.75 -0.27]
        "integer indices" [0 1 2 3]
AttributeEnd
