# Shared geometry for camera_fov1/2/3: three rows of identical unit spheres
# (spacing 2.5) on a checker floor, plus a uv-grid wall. The camera position is
# identical in all three renders; only the field of view changes.
Texture "chk" "spectrum" "checkerboard" "float uscale" [1] "float vscale" [1] "rgb tex1" [0.85 0.85 0.85] "rgb tex2" [0.2 0.2 0.25]
Material "diffuse" "texture reflectance" "chk"
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
Texture "grid" "spectrum" "imagemap" "string filename" "assets/uvgrid.ppm" "float uscale" [0.125] "float vscale" [0.125]
Material "diffuse" "texture reflectance" "grid"
Shape "plane" "point3 p" [0 0 -16] "normal n" [0 0 1]
AttributeBegin
  Translate -12.5 1 0
  Material "phong" "rgb Kd" [0.85 0.7 0.1] "rgb Ks" [0.4 0.4 0.4] "float exponent" [80]
  Shape "sphere" "float radius" [1]
AttributeEnd
