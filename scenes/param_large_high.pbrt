# param_large_high (BF = 8, MD = 3): a closed Cornell box with saturated red/green
# walls, lit by a small ceiling light. Light reaches the shadowed areas, the ceiling
# and the box interiors only after several diffuse inter-reflections, and colour
# bleeding accumulates over multiple bounces, so both a deep tree (MD) and many
# branches per bounce (BF) are needed. Cost grows as BF^MD (~585 hits per pixel sample).
Scale -1 1 1
LookAt 0 1 3.4   0 1 0   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [320] "integer yresolution" [320] "string filename" "param_large_high.png"
     "string tonemap" "reinhard" "float key" [0.2]
Sampler "stratified" "integer xsamples" [2] "integer ysamples" [2]
Integrator "distributed" "integer maxdepth" [3] "integer branching" [8]
           "integer lightsamples" [4] "string lightsampler" "halton"
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [18 16 12]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-0.25 1.995 -0.25   0.25 1.995 -0.25   -0.25 1.995 0.25   0.25 1.995 0.25] "integer indices" [0 1 2 3]
AttributeEnd
Material "diffuse" "rgb reflectance" [0.75 0.75 0.75]
Shape "bilinearmesh" "point3 P" [-1 0 -1   1 0 -1   -1 0 1   1 0 1] "integer indices" [0 1 2 3]
Shape "bilinearmesh" "point3 P" [-1 2 -1   1 2 -1   -1 2 1   1 2 1] "integer indices" [0 1 2 3]
Shape "bilinearmesh" "point3 P" [-1 0 -1   1 0 -1   -1 2 -1   1 2 -1] "integer indices" [0 1 2 3]
Material "diffuse" "rgb reflectance" [0.65 0.06 0.05]
Shape "bilinearmesh" "point3 P" [-1 0 -1   -1 0 1   -1 2 -1   -1 2 1] "integer indices" [0 1 2 3]
Material "diffuse" "rgb reflectance" [0.12 0.5 0.08]
Shape "bilinearmesh" "point3 P" [1 0 -1   1 0 1   1 2 -1   1 2 1] "integer indices" [0 1 2 3]
# Tall and short boxes
AttributeBegin
  Translate -0.35 0.6 -0.35
  Rotate 18 0 1 0
  Scale 0.6 1.2 0.6
  Material "diffuse" "rgb reflectance" [0.75 0.75 0.75]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate 0.4 0.3 0.3
  Rotate -18 0 1 0
  Scale 0.6 0.6 0.6
  Material "diffuse" "rgb reflectance" [0.75 0.75 0.75]
  Shape "objmesh" "string filename" "assets/cube.obj"
AttributeEnd
AttributeBegin
  Translate 0.4 0.85 0.3
  Material "phong" "rgb Kd" [0.6 0.6 0.6] "rgb Ks" [0.3 0.3 0.3] "float exponent" [50]
  Shape "sphere" "float radius" [0.25]
AttributeEnd
