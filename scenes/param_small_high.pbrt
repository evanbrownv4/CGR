# param_small_high (BF = 2, MD = 8): an "infinity mirror" - two parallel mirrors face
# each other with glass and coloured spheres between them. The interesting light
# transport is long chains of ideal specular reflections/refractions (which are not
# branched, so they cost one ray per bounce); every additional depth level adds
# one more visible reflection of the spheres. Diffuse surfaces are few, so a small
# branching factor is sufficient while a high maximum depth is essential.
Scale -1 1 1
LookAt 1.6 1.3 2.2   -2 0.8 -2.4   0 1 0
Camera "perspective" "float fov" [50]
Film "rgb" "integer xresolution" [480] "integer yresolution" [360] "string filename" "param_small_high.png"
     "string tonemap" "reinhard" "float key" [0.2]
Sampler "stratified" "integer xsamples" [2] "integer ysamples" [2]
Integrator "distributed" "integer maxdepth" [8] "integer branching" [2]
           "integer lightsamples" [4] "string lightsampler" "halton"
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [16 15 13]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-0.6 3.5 -1.6   0.6 3.5 -1.6   -0.6 3.5 -0.4   0.6 3.5 -0.4] "integer indices" [0 1 2 3]
AttributeEnd
# Two facing mirrors (x = -2 and x = 2)
Material "mirror" "rgb Kr" [0.92 0.92 0.92]
Shape "bilinearmesh" "point3 P" [-2 0 -6   -2 0 6   -2 3.5 -6   -2 3.5 6] "integer indices" [0 1 2 3]
Shape "bilinearmesh" "point3 P" [2 0 6   2 0 -6   2 3.5 6   2 3.5 -6] "integer indices" [0 1 2 3]
# Mirror floor strip between them and a dark wall at the back
Material "phong" "rgb Kd" [0.15 0.15 0.15] "rgb Ks" [0.1 0.1 0.1] "float exponent" [20] "rgb Kr" [0.5 0.5 0.5]
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
Material "diffuse" "rgb reflectance" [0.3 0.3 0.35]
Shape "plane" "point3 p" [0 0 -6] "normal n" [0 0 1]
AttributeBegin
  Translate 0 0.6 -1
  Material "dielectric" "float eta" [1.5]
  Shape "sphere" "float radius" [0.6]
AttributeEnd
AttributeBegin
  Translate -0.9 0.4 -2.2
  Material "phong" "rgb Kd" [0.75 0.15 0.1] "rgb Ks" [0.2 0.2 0.2] "float exponent" [50]
  Shape "sphere" "float radius" [0.4]
AttributeEnd
AttributeBegin
  Translate 0.9 0.4 -2.2
  Material "phong" "rgb Kd" [0.1 0.25 0.75] "rgb Ks" [0.2 0.2 0.2] "float exponent" [50]
  Shape "sphere" "float radius" [0.4]
AttributeEnd
