# param_small_low (BF = 2, MD = 1): an open "sunlit courtyard". Diffuse/glossy objects
# stand on a large dark floor under a strong sun-like distant light and a small
# area light, with no walls or ceiling. Nearly all radiance is direct, and the only
# meaningful indirect light is one weak bounce from the floor, so a shallow tree with
# few branches already gives an almost converged image at minimum cost.
Scale -1 1 1
LookAt 0 3 8   0 0.8 0   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [480] "integer yresolution" [360] "string filename" "param_small_low.png"
     "string tonemap" "reinhard" "float key" [0.18]
Sampler "stratified" "integer xsamples" [3] "integer ysamples" [3]
Integrator "distributed" "integer maxdepth" [1] "integer branching" [2]
           "integer lightsamples" [9] "string lightsampler" "halton"
WorldBegin
LightSource "distant" "point3 from" [4 8 5] "point3 to" [0 0 0] "rgb L" [2.5 2.4 2.2]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [20 20 24]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-4 5 0  -3 5 0  -4 5 1  -3 5 1] "integer indices" [0 1 2 3]
AttributeEnd
Material "diffuse" "rgb reflectance" [0.25 0.24 0.22]
Shape "plane" "point3 p" [0 0 0] "normal n" [0 1 0]
AttributeBegin
  Translate -1.8 0.8 0
  Material "phong" "rgb Kd" [0.7 0.2 0.15] "rgb Ks" [0.25 0.25 0.25] "float exponent" [40]
  Shape "sphere" "float radius" [0.8]
AttributeEnd
AttributeBegin
  Translate 0.3 0.62 -0.4
  Rotate 20 1 0 0
  Scale 0.8 0.8 0.8
  Material "diffuse" "rgb reflectance" [0.3 0.5 0.75]
  Shape "objmesh" "string filename" "assets/torus.obj"
AttributeEnd
AttributeBegin
  Translate 2.2 0 0.4
  Scale 0.7 0.7 0.7
  Texture "marble" "spectrum" "imagemap" "string filename" "assets/marble.ppm" "float uscale" [2]
  Material "phong" "texture Kd" "marble" "rgb Ks" [0.2 0.2 0.2] "float exponent" [60]
  Shape "objmesh" "string filename" "assets/vase.obj" "bool smooth" true
AttributeEnd
