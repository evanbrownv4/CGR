# testscene_1 (camera): Perspective camera and sphere silhouettes
# Perspective camera (fov 40) with a centred red emissive sphere and an off-centre green one. Checks that sphere boundaries fall on exactly the same pixels as in PBRT.
LookAt 0 0 10   0 0 0   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [200] "integer yresolution" [150] "string filename" "testsuite_ref_1.pfm"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [1 0 0]
  Shape "sphere" "float radius" [1.5]
AttributeEnd
AttributeBegin
  Translate 3.2 1.6 -2
  AreaLightSource "diffuse" "rgb L" [0 1 0]
  Shape "sphere" "float radius" [0.8]
AttributeEnd
