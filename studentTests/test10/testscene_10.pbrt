# testscene_10 (shading): Coloured reflectances under a distant light
# Saturated red, green and blue diffuse spheres under a distant light. Checks the RGB albedo pipeline against PBRT's spectral upsampling (small differences are expected for saturated colours).
LookAt 0 2 7   0 0.6 0   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [160] "integer yresolution" [120] "string filename" "testsuite_ref_10.pfm"
Sampler "independent" "integer pixelsamples" [256]
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "distant" "point3 from" [1 3 2] "point3 to" [0 0 0] "rgb L" [3 3 3]
Material "diffuse" "rgb reflectance" [0.4 0.4 0.4]
Shape "bilinearmesh" "point3 P" [-6 0 -6   6 0 -6   -6 0 6   6 0 6]
AttributeBegin
  Translate -2 0.8 0
  Material "diffuse" "rgb reflectance" [0.8 0.1 0.1]
  Shape "sphere" "float radius" [0.8]
AttributeEnd
AttributeBegin
  Translate 0 0.8 0
  Material "diffuse" "rgb reflectance" [0.1 0.8 0.1]
  Shape "sphere" "float radius" [0.8]
AttributeEnd
AttributeBegin
  Translate 2 0.8 0
  Material "diffuse" "rgb reflectance" [0.1 0.1 0.8]
  Shape "sphere" "float radius" [0.8]
AttributeEnd
