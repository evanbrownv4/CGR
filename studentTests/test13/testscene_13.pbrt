# testscene_13 (shading): Dielectric refraction
# A glass sphere (eta 1.5) in front of a checkerboard wall lit by an area light (PBRT maxdepth 6). Pixels seen through the sphere check refraction directions and Fresnel weighting. Pixels inside the caustic are avoided, because the CGR26 DRT does not render caustics by default.
LookAt 0 1 5   0 1 0   0 1 0
Camera "perspective" "float fov" [40]
Film "rgb" "integer xresolution" [160] "integer yresolution" [120] "string filename" "testsuite_ref_13.pfm"
Sampler "independent" "integer pixelsamples" [256]
PixelFilter "box"
Integrator "path" "integer maxdepth" [6]
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [6 6 6]
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "bilinearmesh" "point3 P" [-1.5 4 1   1.5 4 1   -1.5 4 3   1.5 4 3]
AttributeEnd
Texture "chk" "spectrum" "checkerboard" "float uscale" [8] "float vscale" [8] "rgb tex1" [0.8 0.8 0.8] "rgb tex2" [0.15 0.15 0.5]
Material "diffuse" "texture reflectance" "chk"
Shape "bilinearmesh" "point3 P" [-4 -1 -2   4 -1 -2   -4 5 -2   4 5 -2]
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "bilinearmesh" "point3 P" [-4 0 -2   4 0 -2   -4 0 4   4 0 4]
AttributeBegin
  Translate 0 1 0.5
  Material "dielectric" "float eta" [1.5]
  Shape "sphere" "float radius" [0.7]
AttributeEnd
