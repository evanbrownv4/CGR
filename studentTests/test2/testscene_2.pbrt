# testscene_2 (camera): Triangle/quad intersection and depth ordering
# A green two-sided triangle mesh partly in front of a red sphere and a blue bilinear quad behind both. Checks triangle edges, shared mesh edges, quad intersection and that the nearest surface wins.
LookAt 0 1 8   0 0 0   0 1 0
Camera "perspective" "float fov" [45]
Film "rgb" "integer xresolution" [200] "integer yresolution" [150] "string filename" "testsuite_ref_2.pfm"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [1 0 0]
  Shape "sphere" "float radius" [1.2]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [0 1 0] "bool twosided" true
  Shape "trianglemesh" "integer indices" [0 1 2  0 2 3  2 4 3]
        "point3 P" [-2.5 -1.5 1   0.3 -1.2 1.5   0.6 1.4 1.8   -2.0 0.9 0.6   1.8 2.0 0.2]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [0 0 1] "bool twosided" true
  Shape "bilinearmesh" "point3 P" [-3 -2 -3   3.5 -2 -3   -3 2.5 -3   3.5 2.5 -3]
AttributeEnd
