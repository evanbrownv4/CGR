# testscene_3 (camera): Wide field of view on a 2:1 image
# fov 100 on a 240x120 image with spheres near the corners and edges (strong perspective stretching). Checks the fov convention (fov spans the shorter, vertical axis) and the screen-window mapping for non-square images.
LookAt 0 0 4   0 0 0   0 1 0
Camera "perspective" "float fov" [100]
Film "rgb" "integer xresolution" [240] "integer yresolution" [120] "string filename" "testsuite_ref_3.pfm"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [1 0 0]
  Shape "sphere" "float radius" [0.6]
AttributeEnd
AttributeBegin
  Translate -7 3.2 -1
  AreaLightSource "diffuse" "rgb L" [0 1 0]
  Shape "sphere" "float radius" [0.7]
AttributeEnd
AttributeBegin
  Translate 7.5 -3.3 -1.5
  AreaLightSource "diffuse" "rgb L" [0 0 1]
  Shape "sphere" "float radius" [0.7]
AttributeEnd
AttributeBegin
  Translate 4 0 0
  AreaLightSource "diffuse" "rgb L" [0 1 0]
  Shape "sphere" "float radius" [0.5]
AttributeEnd
