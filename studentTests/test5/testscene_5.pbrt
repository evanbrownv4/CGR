# testscene_5 (camera): Orthographic camera with a screen window
# Orthographic camera with screenwindow [-4 4 -3 3]: two equal spheres at very different depths must have the same projected size, plus a tilted triangle.
LookAt 2 3 10   0 0 0   0 1 0
Camera "orthographic" "float screenwindow" [-4 4 -3 3]
Film "rgb" "integer xresolution" [200] "integer yresolution" [150] "string filename" "testsuite_ref_5.pfm"
Sampler "stratified" "integer xsamples" [1] "integer ysamples" [1] "bool jitter" false
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
Material "diffuse" "rgb reflectance" [0 0 0]
AttributeBegin
  Translate -2 0 3
  AreaLightSource "diffuse" "rgb L" [1 0 0]
  Shape "sphere" "float radius" [1]
AttributeEnd
AttributeBegin
  Translate 2 0.5 -6
  AreaLightSource "diffuse" "rgb L" [0 1 0]
  Shape "sphere" "float radius" [1]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [0 0 1] "bool twosided" true
  Shape "trianglemesh" "integer indices" [0 1 2] "point3 P" [-1 -2.5 0   3 -2 -2   0.5 1.5 1]
AttributeEnd
