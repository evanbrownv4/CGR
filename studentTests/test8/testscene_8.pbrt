# testscene_8 (shading): Lambertian BRDF under a point light
# Grey diffuse sphere on a grey floor lit by one point light, direct lighting only (PBRT maxdepth 1). Expected radiance is reflectance/pi * I cos(theta) / d^2: checks BRDF normalisation, inverse-square falloff and the hard shadow.
LookAt 0 3 6   0 0.6 0   0 1 0
Camera "perspective" "float fov" [45]
Film "rgb" "integer xresolution" [160] "integer yresolution" [120] "string filename" "testsuite_ref_8.pfm"
Sampler "independent" "integer pixelsamples" [256]
PixelFilter "box"
Integrator "path" "integer maxdepth" [1]
WorldBegin
LightSource "point" "point3 from" [2 5 3] "rgb I" [40 40 40]
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "bilinearmesh" "point3 P" [-5 0 -5   5 0 -5   -5 0 5   5 0 5]
AttributeBegin
  Translate 0 1 0
  Material "diffuse" "rgb reflectance" [0.8 0.8 0.8]
  Shape "sphere" "float radius" [1]
AttributeEnd
